APP_PORT=8080
# Development only. Production must use TLS with sslmode=verify-full.
DATABASE_URL=postgres://oshe:oshe@localhost:5432/oshe_payment?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_CONNECT_TIMEOUT=5s

# Enable on both API and notification-worker after applying migrations.
NOTIFICATION_ENABLED=false
BREVO_API_KEY=
NOTIFICATION_SENDER_EMAIL=
NOTIFICATION_SENDER_NAME=OshePayment
# Generate a random secret of at least 32 characters. Configure it as a Bearer
# token on Brevo's transactional webhook for POST /webhooks/brevo.
BREVO_WEBHOOK_TOKEN=

# Manual Swagger testing only. Leave disabled in production.
NOTIFICATION_TEST_API_ENABLED=false
# Separate random secret (at least 32 characters); never reuse the Brevo tokens.
NOTIFICATION_TEST_API_TOKEN=
